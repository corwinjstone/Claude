# Server
PORT=3001
SESSION_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Google Calendar OAuth
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Microsoft (Outlook) OAuth
# https://portal.azure.com/ → App registrations
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:3001/auth/outlook/callback

# Apple iCloud — no OAuth app needed.
# Users provide their Apple ID + app-specific password directly in the UI.
# Generate app-specific passwords at: https://appleid.apple.com/account/manage
